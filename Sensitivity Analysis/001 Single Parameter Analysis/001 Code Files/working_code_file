def focal_length_comparison(
    output_dir, file_end_key='_measurement_statistics.json', key='focal_lengths_parabolic_xy', save_data=False
):
    files = find_files(output_dir, file_end_key)
    df = tabulate_data_from_files(files, key, name_start='sa_', name_end='_')

    if save_data == True:
        analysis_dir = find_or_create_analysis_folder(output_dir)
        csv_path = os.path.join(analysis_dir, 'focal_length_comparison.csv')
        df.to_csv(csv_path, index=False)
        print(f"DataFrame saved to {csv_path}")

    return df


